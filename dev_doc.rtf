  \} = options;\
\
  const amplitude = Math.min(\
    50,\
    Math.max(5, waveHeightM * 8),\
  );\
\
  const centerY = height * 0.55;\
\
  const wave1 = `\
    M0 $\{centerY\}\
    Q$\{width * 0.25\} $\{centerY - amplitude\}\
     $\{width * 0.5\} $\{centerY\}\
    T$\{width\} $\{centerY\}\
    L$\{width\} $\{height\}\
    L0 $\{height\}\
    Z\
  `;\
\
  const wave2 = `\
    M0 $\{centerY + 10\}\
    Q$\{width * 0.25\} $\{centerY + amplitude\}\
     $\{width * 0.5\} $\{centerY + 10\}\
    T$\{width\} $\{centerY + 10\}\
    L$\{width\} $\{height\}\
    L0 $\{height\}\
    Z\
  `;\
\
  return `\
    <svg\
      xmlns="http://www.w3.org/2000/svg"\
      width="$\{width\}"\
      height="$\{height\}"\
      viewBox="0 0 $\{width\} $\{height\}"\
    >\
      <defs>\
        <linearGradient\
          id="seaGradient"\
          x1="0"\
          y1="0"\
          x2="0"\
          y2="1"\
        >\
          <stop offset="0%" stop-color="#7DD3FC"/>\
          <stop offset="100%" stop-color="#075985"/>\
        </linearGradient>\
      </defs>\
\
      <rect\
        width="$\{width\}"\
        height="$\{height\}"\
        fill="#0F172A"\
      />\
\
      <path\
        d="$\{wave1\}"\
        fill="url(#seaGradient)"\
      />\
\
      <path\
        d="$\{wave2\}"\
        fill="#0369A1"\
        opacity="0.65"\
      />\
\
      <rect\
        x="4"\
        y="4"\
        width="$\{width - 8\}"\
        height="$\{height - 8\}"\
        rx="8"\
        fill="none"\
