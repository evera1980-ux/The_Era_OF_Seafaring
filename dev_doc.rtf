\f4\fs26 \cf0 // src/components/common/GameAsset.tsx\
\
import \{\
  useEffect,\
  useState,\
\} from "react";\
\
import type \{\
  CSSProperties,\
\} from "react";\
\
import type \{\
  AssetKey,\
\} from "../../types";\
\
import \{\
  assetRegistry,\
  type AssetRenderRequest,\
  type ResolvedAsset,\
\} from "../../assets/AssetRegistry";\
\
export interface GameAssetProps \{\
  assetId: AssetKey;\
\
  width?: number;\
  height?: number;\
\
  headingDeg?: number;\
\
  vesselCategory?:\
    AssetRenderRequest["vesselCategory"];\
\
  weatherLevel?: number;\
\
  waveHeightM?: number;\
\
  className?: string;\
\
  style?: CSSProperties;\
\
  alt?: string;\
\}\
\
export function GameAsset(\
  props: GameAssetProps,\
) \{\
  const \{\
    assetId,\
    width,\
    height,\
    headingDeg,\
    vesselCategory,\
    weatherLevel,\
    waveHeightM,\
    className,\
    style,\
    alt = "",\
  \} = props;\
\
  const [resolved, setResolved] =\
    useState<ResolvedAsset | null>(null);\
\
  const [imageFailed, setImageFailed] =\
    useState(false);\
\
  useEffect(() => \{\
    const request: AssetRenderRequest = \{\
      assetId,\
      width,\
      height,\
      headingDeg,\
      vesselCategory,\
      weatherLevel,\
      waveHeightM,\
    \};\
\
    const result = assetRegistry.resolve(request);\
\
    setResolved(result);\
    setImageFailed(false);\
  \}, [\
    assetId,\
    width,\
    height,\
    headingDeg,\
    vesselCategory,\
    weatherLevel,\
    waveHeightM,\
  ]);\
\
  if (resolved === null) \{\
    return (\
      <div\
        className=\{className\}\
        style=\{\{\
          width,\
          height,\
          ...style,\
        \}\}\
        aria-label=\{alt\}\
      />\
    );\
  \}\
\
  if (\
    resolved.mode === "image" &&\
    resolved.url !== undefined &&\
    !imageFailed\
  ) \{\
    return (\
      <img\
        src=\{resolved.url\}\
        width=\{resolved.width\}\
        height=\{resolved.height\}\
        className=\{className\}\
        style=\{\{\
          objectFit: "contain",\
          ...style,\
        \}\}\
        alt=\{alt\}\
        onError=\{() => \{\
          setImageFailed(true);\
        \}\}\
      />\
    );\
  \}\
\
  if (resolved.svg !== undefined) \{\
    return (\
      <div\
        className=\{className\}\
        style=\{\{\
          width: resolved.width,\
          height: resolved.height,\
          display: "inline-flex",\
          alignItems: "center",\
          justifyContent: "center",\
          ...style,\
        \}\}\
        role="img"\
        aria-label=\{alt\}\
        dangerouslySetInnerHTML=\{\{\
          __html: resolved.svg,\
        \}\}\
      />\
    );\
  \}\
\
  return null;\
\}\
