  const bodyColor = "#CBD5E1";\
  const outlineColor = "#0F172A";\
\
  let body = "";\
\
  switch (category) \{\
    case "Cargo":\
      body = `\
        <path\
          d="M32 5 L42 18 L45 45 L36 58\
             L28 58 L19 45 L22 18 Z"\
          fill="$\{bodyColor\}"\
          stroke="$\{outlineColor\}"\
          stroke-width="2"\
        />\
        <rect x="25" y="22" width="14" height="16"\
          fill="#64748B"/>\
      `;\
      break;\
\
    case "Tanker":\
      body = `\
        <path\
          d="M32 5 L45 18 L48 45 L37 58\
             L27 58 L16 45 L19 18 Z"\
          fill="#64748B"\
          stroke="$\{outlineColor\}"\
          stroke-width="2"\
        />\
        <rect x="24" y="18" width="16" height="28"\
          rx="4" fill="#B45309"/>\
      `;\
      break;\
\
    case "Sailboat":\
      body = `\
        <path\
          d="M32 5 L42 18 L45 45 L36 58\
             L28 58 L19 45 L22 18 Z"\
          fill="#F8FAFC"\
          stroke="$\{outlineColor\}"\
          stroke-width="2"\
        />\
        <path d="M31 12 L31 40 L18 40 Z"\
          fill="#E2E8F0"/>\
